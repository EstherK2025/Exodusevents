# Copier en `.env` (local) ou renseigner dans Vercel → Settings → Environment Variables.

# Clé API Resend (https://resend.com) pour envoyer les demandes de devis.
# Vide : simulation en local ; en production, le formulaire propose d'écrire par courriel.
RESEND_API_KEY=

# Adresse qui reçoit les demandes de devis.
EXODUS_EMAIL_TO=info@exodusevents.org

# Expéditeur (domaine exodusevents.org à vérifier dans Resend).
EXODUS_EMAIL_FROM=Exodus Events <devis@exodusevents.org>

# Base de données Neon (Postgres) : chaque demande de devis et candidature
# partenaire y est enregistrée (tables créées automatiquement).
# Neon → votre projet « exodusevents » → Connect → copier la chaîne de connexion.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.neon.tech/neondb?sslmode=require

# Mot de passe du tableau de bord https://exodusevents.org/admin
ADMIN_PASSWORD=choisir_un_mot_de_passe_long
